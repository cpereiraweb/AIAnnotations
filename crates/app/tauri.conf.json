{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIAnnotations",
  "version": "0.1.0",
  "identifier": "io.github.cpereiraweb.aiannotations",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5199",
    "beforeDevCommand": "npm run dev -- --port 5199 --strictPort",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AIAnnotations",
        "width": 1100,
        "height": 760,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost ws://localhost:5199"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Claudio Pereira <cpereiraweb>",
    "copyright": "© 2026 Claudio Pereira",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
